### 8.1 `app/Services/PricingService.php`

```php
<?php

namespace App\Services;

use App\Models\Panier;
use App\Models\CodePromo;
use App\Models\Restaurant;

class PricingService
{
    /**
     * Calcule tous les totaux d'une commande
     */
    public function calculerTotauxCommande(Panier $panier, array $donnees): array
    {
        $restaurant = $panier->restaurant;
        
        // Sous-total
        $sousTotal = $this->calculerSousTotal($panier);

        // TVA
        $tva = $this->calculerTva($sousTotal, $restaurant->taux_tva);

        // Frais de livraison
        $fraisLivraison = 0;
        if ($donnees['type_commande'] === 'livraison' && !empty($donnees['adresse_livraison_id'])) {
            $adresse = \App\Models\Adresse::find($donnees['adresse_livraison_id']);
            $fraisLivraison = $this->calculerFraisLivraison($restaurant, $adresse);
        }

        // Code promo
        $reduction = 0;
        $codePromoId = null;
        if (!empty($donnees['code_promo'])) {
            $codePromo = CodePromo::where('code', strtoupper($donnees['code_promo']))->first();
            
            if ($codePromo) {
                $commandeTemporaire = new \App\Models\Commande([
                    'client_id' => $panier->client_id,
                    'restaurant_id' => $panier->restaurant_id,
                    'sous_total' => $sousTotal,
                ]);

                if ($codePromo->estValidePour($commandeTemporaire)) {
                    $reduction = $codePromo->calculerReduction($sousTotal);
                    $codePromoId = $codePromo->id;
                }
            }
        }

        // Total final
        $total = $sousTotal + $fraisLivraison - $reduction;

        return [
            'sous_total' => round($sousTotal, 2),
            'tva' => round($tva, 2),
            'frais_livraison' => round($fraisLivraison, 2),
            'reduction' => round($reduction, 2),
            'total' => round(max(0, $total), 2),
            'code_promo_id' => $codePromoId,
        ];
    }

    /**
     * Calcule le sous-total du panier
     */
    public function calculerSousTotal(Panier $panier): float
    {
        return $panier->lignes->sum(function ($ligne) {
            $prixOptions = collect($ligne->options ?? [])->sum('prix');
            return ($ligne->prix_unitaire + $prixOptions) * $ligne->quantite;
        });
    }

    /**
     * Calcule la TVA
     */
    public function calculerTva(float $sousTotal, float $tauxTva): float
    {
        $taux = $tauxTva / 100;
        return $sousTotal * $taux / (1 + $taux);
    }

    /**
     * Calcule les frais de livraison
     */
    public function calculerFraisLivraison(Restaurant $restaurant, $adresse): float
    {
        $zones = $restaurant->zonesLivraison()->actives()->get();
        
        foreach ($zones as $zone) {
            if ($zone->contientPoint($adresse->latitude, $adresse->longitude)) {
                return $zone->frais_livraison;
            }
        }
        
        return 1500; // Frais par défaut
    }

    /**
     * Calcule le prix final d'un produit avec options
     */
    public function calculerPrixProduit($produit, ?string $varianteId = null, array $options = []): float
    {
        $prix = $produit->prix_actuel;

        // Variante
        if ($varianteId) {
            $variante = $produit->variantes->find($varianteId);
            if ($variante) {
                $prix += $variante->modificateur_prix;
            }
        }

        // Options (suppléments)
        foreach ($options as $option) {
            $prix += $option['prix'] ?? 0;
        }

        return $prix;
    }
}
