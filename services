class ReservationService
{
    public function __construct(
        private NotificationService $notificationService
    ) {}

    /**
     * Crée une réservation
     */
    public function creerReservation(ProfilClient $client, array $donnees): Reservation
    {
        return DB::transaction(function () use ($client, $donnees) {
            
            $restaurant = Restaurant::findOrFail($donnees['restaurant_id']);

            // Vérifier disponibilité
            $this->verifierDisponibilite($restaurant, $donnees);

            // Trouver une table disponible
            $table = $this->trouverTableDisponible($restaurant, $donnees);

            if (!$table) {
                throw new ReservationIndisponibleException('Aucune table disponible pour ce créneau');
            }

            // Créer la réservation
            $reservation = Reservation::create([
                'client_id' => $client->id,
                'restaurant_id' => $restaurant->id,
                'table_id' => $table->id,
                'salle_id' => $table->salle_id,
                'date_reservation' => $donnees['date_reservation'],
                'heure_reservation' => $donnees['heure_reservation'],
                'duree_minutes' => $donnees['duree_minutes'] ?? 120,
                'nombre_personnes' => $donnees['nombre_personnes'],
                'statut' => 'en_attente',
                'nom_client' => $donnees['nom_client'] ?? $client->utilisateur->nom_complet,
                'telephone_client' => $donnees['telephone_client'] ?? $client->utilisateur->telephone,
                'email_client' => $donnees['email_client'] ?? $client->utilisateur->email,
                'occasion_speciale' => $donnees['occasion_speciale'] ?? null,
                'notes' => $donnees['notes'] ?? null,
            ]);

