```php
<?php

namespace App\Services;

use App\Models\ProfilClient;
use App\Models\TransactionFidelite;
use App\Models\Commande;

class LoyaltyService
{
    /**
     * Attribue des points de fidélité
     */
    public function attribuerPoints(ProfilClient $client, int $points, string $description, ?Commande $commande = null): void
    {
        $ancienSolde = $client->points_fidelite;
        $client->increment('points_fidelite', $points);

        TransactionFidelite::create([
            'client_id' => $client->id,
            'commande_id' => $commande?->id,
            'type_transaction' => 'gain',
            'nombre_points' => $points,
            'solde_avant' => $ancienSolde,
            'solde_apres' => $client->points_fidelite,
            'description' => $description,
        ]);
    }

    /**
     * Utilise des points de fidélité
     */
    public function utiliserPoints(ProfilClient $client, int $points, string $description): bool
    {
        if ($client->points_fidelite < $points) {
            return false;
        }

        $ancienSolde = $client->points_fidelite;
        $client->decrement('points_fidelite', $points);

        TransactionFidelite::create([
            'client_id' => $client->id,
            'type_transaction' => 'utilisation',
            'nombre_points' => -$points,
            'solde_avant' => $ancienSolde,
            'solde_apres' => $client->points_fidelite,
            'description' => $description,
        ]);

        return true;
    }

    /**
     * Convertit des points en réduction monétaire
     */
    public function convertirPointsEnReduction(int $points): float
    {
        // 100 points = 10 FCFA de réduction
        return ($points / 100) * 10;
    }

    /**
     * Calcule les points à attribuer pour une commande
     */
    public function calculerPointsPourCommande(Commande $commande): int
    {
        // 1 point par 100 FCFA dépensés
        return (int) floor($commande->montant_total / 100);
    }

    /**
     * Fait expirer les points anciens (plus de 12 mois)
     */
    public function faireExpirerPoints(): void
    {
        $dateLimite = now()->subYear();

        $transactions = TransactionFidelite::where('type_transaction', 'gain')
            ->where('cree_le', '<', $dateLimite)
            ->whereNull('commande_id') // Points bonus
            ->get();

        foreach ($transactions as $transaction) {
            $client = $transaction->client;
            $pointsAAjuster = $transaction->nombre_points;

            if ($client->points_fidelite >= $pointsAAjuster) {
                $ancienSolde = $client->points_fidelite;
                $client->decrement('points_fidelite', $pointsAAjuster);

                TransactionFidelite::create([
                    'client_id' => $client->id,
                    'type_transaction' => 'expiration',
                    'nombre_points' => -$pointsAAjuster,
                    'solde_avant' => $ancienSolde,
                    'solde_apres' => $client->points_fidelite,
                    'description' => 'Expiration des points (plus de 12 mois)',
                ]);
            }
        }
    }

    /**
     * Obtient le niveau de fidélité d'un client
     */
    public function getNiveauFidelite(ProfilClient $client): array
    {
        $points = $client->points_fidelite;

        $niveaux = [
            ['nom' => 'Standard', 'min' => 0, 'max' => 49, 'couleur' => 'gray'],
            ['nom' => 'Bronze', 'min' => 50, 'max' => 199, 'couleur' => '#cd7f32'],
            ['nom' => 'Argent', 'min' => 200, 'max' => 499, 'couleur' => '#c0c0c0'],
            ['nom' => 'Or', 'min' => 500, 'max' => 999, 'couleur' => '#ffd700'],
            ['nom' => 'Platine', 'min' => 1000, 'max' => PHP_INT_MAX, 'couleur' => '#e5e4e2'],
        ];

        foreach ($niveaux as $niveau) {
            if ($points >= $niveau['min'] && $points <= $niveau['max']) {
                return $niveau;
            }
        }

        return $niveaux[0];
    }
}
