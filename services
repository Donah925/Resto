        $this->notificationService->confirmerReservationClient($reservation);
    }

    /**
     * Refuse une réservation
     */
    public function refuserReservation(Reservation $reservation, string $raison): void
    {
        $reservation->changerStatut('refusee', $raison);
        $this->notificationService->notifierReservationRefusee($reservation, $raison);
