## 💳 3. PAYMENT SERVICE

### 3.1 `app/Services/PaymentService.php`

```php
<?php

namespace App\Services;

use App\Models\Commande;
use App\Models\Paiement;
use App\Models\TransactionPaiement;
use App\Models\Remboursement;
use App\Enums\MethodePaiement;
use App\Exceptions\PaiementEchoueException;
use Illuminate\Support\Str;
use Illuminate\Support\Facades\Log;

class PaymentService
{
    /**
     * Initie le paiement selon la méthode choisie
     */
    public function initierPaiement(Commande $commande, array $donnees): Paiement
    {
        $methode = MethodePaiement::from($donnees['methode_paiement']);

        try {
            return match($methode) {
                MethodePaiement::CARTE_BANCAIRE => $this->payerParCarte($commande),
                MethodePaiement::MTN_MOBILE_MONEY => $this->payerParMtn($commande, $donnees['telephone_mobile_money']),
                MethodePaiement::MOOV_MONEY => $this->payerParMoov($commande, $donnees['telephone_mobile_money']),
                MethodePaiement::ORANGE_MONEY => $this->payerParOrange($commande, $donnees['telephone_mobile_money']),
                MethodePaiement::WAVE => $this->payerParWave($commande, $donnees['telephone_mobile_money']),
                MethodePaiement::PAYPAL => $this->payerParPaypal($commande),
                MethodePaiement::PAYEER => $this->payerParPayeer($commande),
                MethodePaiement::PAYONEER => $this->payerParPayoneer($commande),
                MethodePaiement::PORTEFEUILLE => $this->payerParPortefeuille($commande),
                MethodePaiement::CARTE_CADEAU => $this->payerParCarteCadeau($commande, $donnees['code_carte_cadeau']),
                MethodePaiement::ESPECES_LIVRAISON => $this->payerEspeces($commande),
                default => throw new \Exception('Méthode de paiement non supportée'),
            };
        } catch (\Exception $e) {
            Log::error('Erreur paiement', [
                'commande_id' => $commande->id,
                'methode' => $methode->value,
                'error' => $e->getMessage(),
            ]);
            throw new PaiementEchoueException('Erreur lors du paiement: ' . $e->getMessage());
        }
    }

    /**
     * Paiement par carte bancaire via Stripe
     */
    private function payerParCarte(Commande $commande): Paiement
    {
        $paiement = Paiement::create([
            'commande_id' => $commande->id,
            'client_id' => $commande->client_id,
            'reference_transaction' => 'PAY-' . strtoupper(Str::random(16)),
            'methode_paiement' => MethodePaiement::CARTE_BANCAIRE,
            'prestataire' => 'stripe',
            'montant' => $commande->montant_total,
            'devise' => $commande->restaurant->devise ?? 'XOF',
            'statut' => 'en_attente',
        ]);

        // Créer un PaymentIntent Stripe
        $intent = \Stripe\PaymentIntent::create([
            'amount' => (int) ($commande->montant_total * 100),
            'currency' => strtolower($commande->restaurant->devise ?? 'xof'),
            'metadata' => [
                'commande_id' => $commande->id,
                'commande_numero' => $commande->numero,
                'paiement_id' => $paiement->id,
                'client_id' => $commande->client_id,
            ],
            'description' => "Commande #{$commande->numero}",
        ]);

        $paiement->update([
            'reference_prestataire' => $intent->id,
            'metadata' => ['client_secret' => $intent->client_secret],
        ]);

        // Logger la transaction
        $this->loggerTransaction($paiement, 'autorisation', $commande->montant_total, 'en_attente', [
            'stripe_intent_id' => $intent->id,
        ]);

        return $paiement;
    }

    /**
     * Paiement MTN Mobile Money
     */
    private function payerParMtn(Commande $commande, string $telephone): Paiement
    {
        $paiement = Paiement::create([
            'commande_id' => $commande->id,
            'client_id' => $commande->client_id,
            'reference_transaction' => 'PAY-MTN-' . strtoupper(Str::random(12)),
            'methode_paiement' => MethodePaiement::MTN_MOBILE_MONEY,
            'prestataire' => 'mtn',
            'montant' => $commande->montant_total,
            'devise' => 'XOF',
            'telephone_mobile_money' => $telephone,
            'statut' => 'en_attente',
        ]);

        // Appel API MTN MoMo
        $response = $this->appelerApiMtn($paiement, $telephone);

        $paiement->update([
            'reference_prestataire' => $response['transaction_id'],
        ]);

        $this->loggerTransaction($paiement, 'autorisation', $commande->montant_total, 'en_attente', $response);

        return $paiement;
    }

