    /**
     * Paiement par portefeuille client
     */
    private function payerParPortefeuille(Commande $commande): Paiement
    {
        $portefeuille = $commande->client->portefeuille;

        if (!$portefeuille || $portefeuille->solde < $commande->montant_total) {
            throw new \Exception('Solde portefeuille insuffisant');
        }

        // Débiter le portefeuille
        $portefeuille->debiter($commande->montant_total, "Paiement commande #{$commande->numero}");

        // Créer le paiement
        $paiement = Paiement::create([
            'commande_id' => $commande->id,
            'client_id' => $commande->client_id,
            'reference_transaction' => 'PAY-WAL-' . strtoupper(Str::random(12)),
            'methode_paiement' => MethodePaiement::PORTEFEUILLE,
            'prestataire' => 'interne',
            'montant' => $commande->montant_total,
            'devise' => $portefeuille->devise,
            'statut' => 'reussi',
            'heure_paiement' => now(),
        ]);

        return $paiement;
    }

    /**
     * Paiement par carte cadeau
     */
    private function payerParCarteCadeau(Commande $commande, string $codeCarte): Paiement
    {
        $carte = \App\Models\CarteCadeau::where('code', $codeCarte)->first();

        if (!$carte || $carte->statut !== 'active') {
            throw new \Exception('Carte cadeau invalide ou expirée');
        }

        if ($carte->montant_restant < $commande->montant_total) {
            throw new \Exception('Solde carte cadeau insuffisant');
        }

        // Utiliser la carte
        $carte->utiliser($commande->montant_total);

        $paiement = Paiement::create([
            'commande_id' => $commande->id,
            'client_id' => $commande->client_id,
            'reference_transaction' => 'PAY-GIFT-' . strtoupper(Str::random(12)),
            'methode_paiement' => MethodePaiement::CARTE_CADEAU,
            'prestataire' => 'interne',
            'montant' => $commande->montant_total,
            'devise' => $carte->devise,
            'statut' => 'reussi',
            'heure_paiement' => now(),
        ]);

        return $paiement;
    }

    /**
     * Paiement espèces à la livraison
     */
    private function payerEspeces(Commande $commande): Paiement
    {
        return Paiement::create([
            'commande_id' => $commande->id,
            'client_id' => $commande->client_id,
            'reference_transaction' => 'PAY-CASH-' . strtoupper(Str::random(12)),
            'methode_paiement' => MethodePaiement::ESPECES_LIVRAISON,
            'prestataire' => 'interne',
            'montant' => $commande->montant_total,
            'devise' => 'XOF',
            'statut' => 'en_attente', // Sera confirmé à la livraison
        ]);
    }

    /**
     * Confirmer un paiement (après webhook ou confirmation manuelle)
     */
    public function confirmerPaiement(Paiement $paiement): void
    {
        if ($paiement->statut === 'reussi') {
            return;
        }

        $paiement->update([
            'statut' => 'reussi',
            'heure_paiement' => now(),
        ]);

        $this->loggerTransaction($paiement, 'capture', $paiement->montant, 'reussi');

        // Confirmer la commande
        $paiement->commande->changerStatut(\App\Enums\StatutCommande::CONFIRMEE);
    }

    /**
     * Rembourser un paiement
     */
    public function rembourser(Paiement $paiement, string $raison): void
    {
        if ($paiement->statut !== 'reussi') {
            throw new \Exception('Seuls les paiements réussis peuvent être remboursés');
        }

        match($paiement->prestataire) {
            'stripe' => $this->rembourserStripe($paiement, $raison),
            'mtn' => $this->rembourserMtn($paiement, $raison),
            'interne' => $this->rembourserInterne($paiement, $raison),
            default => throw new \Exception('Remboursement non supporté pour ce prestataire'),
        };
    }

    /**
     * Traiter le webhook Stripe
     */
    public function traiterWebhookStripe($event): void
    {
        match($event->type) {
            'payment_intent.succeeded' => $this->onStripePaymentSucceeded($event->data->object),
            'payment_intent.payment_failed' => $this->onStripePaymentFailed($event->data->object),
            'charge.refunded' => $this->onStripeRefunded($event->data->object),
            default => Log::info("Stripe webhook non géré: {$event->type}"),
        };
    }

    /**
     * Traiter le webhook MTN
     */
    public function traiterWebhookMtn(array $data): void
    {
        $reference = $data['reference'] ?? null;
        $paiement = Paiement::where('reference_prestataire', $reference)->first();

        if (!$paiement) {
            Log::warning('Webhook MTN: paiement introuvable', $data);
            return;
        }

        if ($data['status'] === 'successful') {
            $this->confirmerPaiement($paiement);
        } elseif ($data['status'] === 'failed') {
            $paiement->update(['statut' => 'echoue']);
        }
    }

    // ===== MÉTHODES PRIVÉES =====

    private function loggerTransaction(Paiement $paiement, string $type, float $montant, string $statut, array $donnees = []): void
    {
        TransactionPaiement::create([
            'paiement_id' => $paiement->id,
            'type_transaction' => $type,
            'montant' => $montant,
            'statut' => $statut,
            'donnees_reponse' => $donnees,
            'adresse_ip' => request()->ip(),
        ]);
    }

    private function appelerApiMtn($paiement, $telephone): array
    {
        // TODO: Implémenter appel API MTN MoMo
        return [
            'transaction_id' => 'MTN-' . Str::random(16),
            'status' => 'pending',
        ];
    }

    private function appelerApiMoov($paiement, $telephone): array
    {
        // TODO: Implémenter appel API Moov
        return ['transaction_id' => 'MOOV-' . Str::random(16)];
    }

    private function appelerApiOrangeMoney($paiement, $telephone): array
    {
        // TODO: Implémenter appel API Orange Money
        return ['transaction_id' => 'OM-' . Str::random(16)];
    }

    private function appelerApiWave($paiement, $telephone): array
    {
        // TODO: Implémenter appel API Wave
        return ['transaction_id' => 'WAVE-' . Str::random(16)];
    }

    private function appelerApiPaypal($paiement): array
    {
        // TODO: Implémenter appel API PayPal
        return ['order_id' => 'PAYPAL-' . Str::random(16)];
    }

    private function rembourserStripe($paiement, string $raison): void
    {
        \Stripe\Refund::create([
            'payment_intent' => $paiement->reference_prestataire,
        ]);

        $paiement->update(['statut' => 'rembourse']);

        Remboursement::create([
            'paiement_id' => $paiement->id,
            'commande_id' => $paiement->commande_id,
            'montant' => $paiement->montant,
            'raison' => $raison,
            'statut' => 'effectue',
            'heure_traitement' => now(),
        ]);
    }

    private function rembourserMtn($paiement, string $raison): void
    {
        // TODO: API remboursement MTN
        $paiement->update(['statut' => 'rembourse']);
    }

    private function rembourserInterne($paiement, string $raison): void
    {
        // Rembourser le portefeuille
        $portefeuille = $paiement->client->portefeuille;
        if ($portefeuille) {
            $portefeuille->crediter($paiement->montant, "Remboursement commande #{$paiement->commande->numero}");
        }

        $paiement->update(['statut' => 'rembourse']);
    }

    private function onStripePaymentSucceeded($paymentIntent): void
    {
        $paiement = Paiement::where('reference_prestataire', $paymentIntent->id)->first();
        
        if ($paiement) {
            $this->confirmerPaiement($paiement);
        }
    }

    private function onStripePaymentFailed($paymentIntent): void
    {
        $paiement = Paiement::where('reference_prestataire', $paymentIntent->id)->first();
        
        if ($paiement) {
            $paiement->update(['statut' => 'echoue']);
            $this->loggerTransaction($paiement, 'autorisation', $paiement->montant, 'echoue', [
                'error' => $paymentIntent->last_payment_error?->message ?? 'Paiement échoué',
            ]);
        }
    }

    private function onStripeRefunded($charge): void
    {
        $paiement = Paiement::where('reference_prestataire', $charge->payment_intent)->first();
        
        if ($paiement) {
            $paiement->update(['statut' => 'rembourse']);
        }
    }
}
