    /**
     * Récupère les créneaux disponibles pour un restaurant
     */
    public function getCreneauxDisponibles(Restaurant $restaurant, string $date, int $nombrePersonnes): array
    {
        $creneaux = [];
        $horaires = $restaurant->horaires()->where('jour_semaine', Carbon::parse($date)->dayOfWeek)->first();

        if (!$horaires || $horaires->est_ferme) {
            return [];
        }

        $ouverture = Carbon::parse($horaires->heure_ouverture);
        $fermeture = Carbon::parse($horaires->heure_fermeture);
        $interval = 30; // Créneaux de 30 minutes

        $creneau = $ouverture->copy();

        while ($creneau->lt($fermeture->copy()->subMinutes(60))) {
            $disponible = $this->verifierCreneauDisponible($restaurant, $date, $creneau->format('H:i:s'), $nombrePersonnes);
            
            if ($disponible) {
                $creneaux[] = [
                    'heure' => $creneau->format('H:i'),
                    'disponible' => true,
                ];
            }

            $creneau->addMinutes($interval);
        }

        return $creneaux;
    }

    /**
     * Envoie les rappels de réservation (à appeler via cron)
     */
    public function envoyerRappels(): void
    {
        $reservations = Reservation::confirmees()
            ->whereDate('date_reservation', now()->addDay()->toDateString())
            ->get();

        foreach ($reservations as $reservation) {
            $this->notificationService->rappelerReservation($reservation);
        }
    }

    // ===== MÉTHODES PRIVÉES =====

    private function verifierDisponibilite(Restaurant $restaurant, array $donnees): void
    {
        $date = Carbon::parse($donnees['date_reservation']);
        $heure = $donnees['heure_reservation'];

        // Vérifier que le restaurant est ouvert ce jour-là
        $jourSemaine = $date->dayOfWeek;
        $horaire = $restaurant->horaires()->where('jour_semaine', $jourSemaine)->first();

        if (!$horaire || $horaire->est_ferme) {
            throw new ReservationIndisponibleException('Le restaurant est fermé ce jour-là');
        }

        // Vérifier les horaires
        $heureReservation = Carbon::parse($date->format('Y-m-d') . ' ' . $heure);
        $ouverture = Carbon::parse($date->format('Y-m-d') . ' ' . $horaire->heure_ouverture);
        $fermeture = Carbon::parse($date->format('Y-m-d') . ' ' . $horaire->heure_fermeture);

        if ($heureReservation->lt($ouverture) || $heureReservation->gt($fermeture->subMinutes(60))) {
            throw new ReservationIndisponibleException('Horaire en dehors des heures d\'ouverture');
        }

        // Vérifier fermetures spéciales
        $fermetureSpeciale = $restaurant->fermeturesSpeciales()
            ->where('date_debut', '<=', $date)
            ->where('date_fin', '>=', $date)
            ->exists();

        if ($fermetureSpeciale) {
            throw new ReservationIndisponibleException('Le restaurant est fermé pour une raison exceptionnelle');
        }
    }

    private function trouverTableDisponible(Restaurant $restaurant, array $donnees)
    {
        $date = $donnees['date_reservation'];
        $heure = $donnees['heure_reservation'];
        $duree = $donnees['duree_minutes'] ?? 120;
        $nbPersonnes = $donnees['nombre_personnes'];

        // Trouver les tables avec assez de places
        $tables = $restaurant->tables()
            ->where('est_active', true)
            ->where('places', '>=', $nbPersonnes)
            ->get();

        foreach ($tables as $table) {
            // Vérifier qu'il n'y a pas de conflit de réservation
            $conflit = Reservation::where('restaurant_id', $restaurant->id)
                ->where('table_id', $table->id)
                ->where('date_reservation', $date)
                ->whereIn('statut', ['en_attente', 'confirmee'])
                ->where(function($query) use ($heure, $duree) {
                    $finReservation = Carbon::parse($heure)->addMinutes($duree);
                    $query->whereBetween('heure_reservation', [$heure, $finReservation->format('H:i:s')])
                          ->orWhereRaw("ADDTIME(heure_reservation, SEC_TO_TIME(? * 60)) > ?", [$duree, $heure]);
                })
                ->exists();

            if (!$conflit) {
                return $table;
            }
        }

        return null;
    }

    private function verifierCreneauDisponible(Restaurant $restaurant, string $date, string $heure, int $nbPersonnes): bool
    {
        $reservations = Reservation::where('restaurant_id', $restaurant->id)
            ->where('date_reservation', $date)
            ->whereIn('statut', ['en_attente', 'confirmee'])
            ->count();

        // Vérifier si la capacité totale n'est pas dépassée
        $capaciteTotale = $restaurant->salles()->sum('capacite');
        $personnesReservees = Reservation::where('restaurant_id', $restaurant->id)
            ->where('date_reservation', $date)
            ->whereIn('statut', ['en_attente', 'confirmee'])
            ->where('heure_reservation', $heure)
            ->sum('nombre_personnes');

        return ($personnesReservees + $nbPersonnes) <= $capaciteTotale;
    }
}
