<?php

namespace App\Services;

use App\Models\Livraison;
use App\Models\ProfilLivreur;
use App\Models\Commande;
use App\Models\SuiviLivraison;
use App\Models\PreuveLivraison;
use App\Enums\StatutCommande;
use App\Exceptions\LivraisonNonAssigneeException;
use Illuminate\Support\Facades\DB;
use Illuminate\Support\Facades\Log;

class DeliveryService
{
    public function __construct(
        private NotificationService $notificationService
    ) {}

    /**
     * Déclenche l'assignation automatique d'un livreur
     */
    public function declencherAssignationLivreur(Livraison $livraison): void
    {
        $livreur = $this->trouverMeilleurLivreur($livraison->commande);

        if ($livreur) {
            $this->assignerLivreur($livraison, $livreur);
        } else {
            Log::warning("Aucun livreur disponible pour la livraison {$livraison->id}");
            // TODO: Mettre en file d'attente et réessayer plus tard
        }
    }

    /**
     * Trouve le meilleur livreur disponible
     */
    public function trouverMeilleurLivreur(Commande $commande): ?ProfilLivreur
    {
        $restaurant = $commande->restaurant;

        // Livreurs disponibles dans un rayon de 5km
        $livreurs = ProfilLivreur::disponibles()
            ->dansZone(
                $restaurant->latitude,
                $restaurant->longitude,
                5
            )
            ->with('utilisateur')
            ->get();

        if ($livreurs->isEmpty()) {
            return null;
        }

        // Calculer un score pour chaque livreur
        $livreursScores = $livreurs->map(function ($livreur) use ($restaurant) {
            $distance = $this->calculerDistance(
                $restaurant->latitude,
                $restaurant->longitude,
                $livreur->latitude_courante,
                $livreur->longitude_courante
            );

            // Score : note (0-5) * 20 + (10 - distance) * 5
            $score = ($livreur->note * 20) + (max(0, 10 - $distance) * 5);

            return [
                'livreur' => $livreur,
                'score' => $score,
                'distance' => $distance,
            ];
        });

        // Retourner le livreur avec le meilleur score
        $meilleur = $livreursScores->sortByDesc('score')->first();

        return $meilleur['livreur'];
    }

    /**
     * Assigne un livreur à une livraison
     */
    public function assignerLivreur(Livraison $livraison, ProfilLivreur $livreur): void
    {
        DB::transaction(function () use ($livraison, $livreur) {
            $livraison->update([
                'livreur_id' => $livreur->id,
                'statut' => 'assignee',
                'heure_prise_en_charge' => now(),
            ]);

            $livreur->update(['est_disponible' => false]);

            // Notifier le livreur
            $this->notificationService->notifierLivreurNouvelleMission($livraison);
            
            // Notifier le client
            $this->notificationService->notifierClientLivreurAssign($livraison);

            Log::info("Livraison {$livraison->id} assignée au livreur {$livreur->id}");
        });
    }

    /**
     * Change le statut d'une livraison
     */
    public function changerStatut(Livraison $livraison, string $nouveauStatut): void
    {
        $transitions = [
            'assignee' => ['en_route_restaurant'],
            'en_route_restaurant' => ['recuperee'],
            'recuperee' => ['en_livraison'],
            'en_livraison' => ['livree'],
        ];

        $statutActuel = $livraison->statut;
        $transitionsPossibles = $transitions[$statutActuel] ?? [];

        if (!in_array($nouveauStatut, $transitionsPossibles)) {
            throw new \Exception("Transition de statut invalide: {$statutActuel} → {$nouveauStatut}");
        }

        $livraison->update(['statut' => $nouveauStatut]);

        // Synchroniser avec la commande
        $this->synchroniserStatutCommande($livraison, $nouveauStatut);

        // Notifier le client
        $this->notificationService->notifierClientStatutLivraison($livraison);
    }

    /**
     * Enregistre la position du livreur
     */
    public function enregistrerPosition(Livraison $livraison, ProfilLivreur $livreur, float $lat, float $lng, ?float $vitesse = null, ?float $direction = null): void
    {
        // Mettre à jour la position du livreur
        $livreur->mettreAJourLocalisation($lat, $lng);

        // Enregistrer le suivi
        SuiviLivraison::create([
            'livraison_id' => $livraison->id,
            'livreur_id' => $livreur->id,
            'latitude' => $lat,
            'longitude' => $lng,
            'vitesse' => $vitesse,
            'direction' => $direction,
        ]);

        // Broadcast en temps réel
        broadcast(new \App\Events\LivraisonPositionUpdated($livraison->id, [
            'lat' => $lat,
            'lng' => $lng,
        ]))->toOthers();
    }

    /**
     * Marque une livraison comme livrée
     */
    public function marquerLivree(Livraison $livraison, array $donneesPreuve): void
    {
        DB::transaction(function () use ($livraison, $donneesPreuve) {
            
            // Créer la preuve de livraison
            $preuve = PreuveLivraison::create([
                'livraison_id' => $livraison->id,
                'type_preuve' => $donneesPreuve['type_preuve'],
                'chemin_fichier' => $donneesPreuve['chemin_fichier'] ?? null,
                'signature_base64' => $donneesPreuve['signature_base64'] ?? null,
                'code_confirmation' => $donneesPreuve['code_confirmation'] ?? null,
                'nom_destinataire' => $donneesPreuve['nom_destinataire'] ?? null,
                'latitude' => $donneesPreuve['latitude'] ?? null,
                'longitude' => $donneesPreuve['longitude'] ?? null,
            ]);

            // Mettre à jour la livraison
            $livraison->update([
                'statut' => 'livree',
                'heure_livraison' => now(),
            ]);

            // Créditer le livreur
            $livreur = $livraison->livreur;
            $livreur->increment('total_livraisons');
            $livreur->increment('total_gains', $livraison->commission_livreur);
            $livreur->update(['est_disponible' => true]);

            // Mettre à jour la commande
            $livraison->commande->changerStatut(StatutCommande::LIVREE);

            // Notifier
            $this->notificationService->notifierLivraisonEffectuee($livraison);

            Log::info("Livraison {$livraison->id} marquée comme livrée");
        });
    }

    /**
     * Calcule les frais de livraison selon la zone
     */
    public function calculerFraisLivraison($restaurant, $adresse): float
    {
        $zones = $restaurant->zonesLivraison()->actives()->get();
        
        foreach ($zones as $zone) {
            if ($zone->contientPoint($adresse->latitude, $adresse->longitude)) {
                return $zone->frais_livraison;
            }
        }
        
        // Frais par défaut si hors zone
        return 1500;
    }

    /**
     * Calcule la distance entre 2 points (formule Haversine)
     */
    public function calculerDistance(float $lat1, float $lon1, float $lat2, float $lon2): float
    {
        $rayonTerre = 6371; // km
        $dLat = deg2rad($lat2 - $lat1);
        $dLon = deg2rad($lon2 - $lon1);

        $a = sin($dLat / 2) * sin($dLat / 2) +
             cos(deg2rad($lat1)) * cos(deg2rad($lat2)) *
             sin($dLon / 2) * sin($dLon / 2);

        $c = 2 * atan2(sqrt($a), sqrt(1 - $a));

        return $rayonTerre * $c;
    }

    // ===== MÉTHODES PRIVÉES =====

    private function synchroniserStatutCommande(Livraison $livraison, string $statutLivraison): void
    {
        $statutCommande = match($statutLivraison) {
            'en_livraison' => StatutCommande::EN_LIVRAISON,
            'livree' => StatutCommande::LIVREE,
            default => null,
        };

        if ($statutCommande) {
            $livraison->commande->changerStatut($statutCommande);
        }
    }
}
