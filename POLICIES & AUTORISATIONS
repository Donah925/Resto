        return true; // Tout utilisateur connecté peut créer un ticket
    }

    public function repondre(Utilisateur $user, TicketSupport $ticket): bool
    {
        // Le client peut répondre à ses propres tickets
        if ($user->role === RoleUtilisateur::CLIENT) {
            return $ticket->client_id === $user->profilClient?->id;
        }

        // Le staff peut répondre à tous les tickets
        return in_array($user->role, [
            RoleUtilisateur::SUPERADMIN,
            RoleUtilisateur::ADMIN,
            RoleUtilisateur::GERANT,
        ]);
    }
