<?php

namespace App\Policies;

use App\Models\Utilisateur;
use App\Models\Produit;
use App\Enums\RoleUtilisateur;

class ProduitPolicy
{
    public function viewAny(Utilisateur $user): bool
    {
        return true; // Public
    }

    public function view(Utilisateur $user, Produit $produit): bool
    {
        return true; // Public
    }

    public function create(Utilisateur $user): bool
    {
        return in_array($user->role, [
            RoleUtilisateur::SUPERADMIN,
            RoleUtilisateur::ADMIN,
            RoleUtilisateur::GERANT,
        ]);
    }

    public function update(Utilisateur $user, Produit $produit): bool
    {
        if ($user->role === RoleUtilisateur::SUPERADMIN) {
            return true;
        }

        if ($user->role === RoleUtilisateur::ADMIN) {
            // Vérifier que le produit appartient à un de ses restaurants
            $restaurantIds = $user->profilAdmin?->restaurants->pluck('id') ?? [];
            return $produit->categorie->restaurant_id 
                && in_array($produit->categorie->restaurant_id, $restaurantIds->toArray());
        }

        if ($user->role === RoleUtilisateur::GERANT) {
            return $produit->categorie->restaurant_id === $user->profilGerant?->restaurant_id;
        }

        return false;
    }

    public function delete(Utilisateur $user, Produit $produit): bool
    {
        return $this->update($user, $produit);
    }
}
