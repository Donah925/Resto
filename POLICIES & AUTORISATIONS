    {
        if ($user->role === RoleUtilisateur::SUPERADMIN) {
            return true;
        }

        if ($user->role === RoleUtilisateur::GERANT) {
            return $avis->restaurant_id === $user->profilGerant?->restaurant_id;
        }

        return false;
    }

    public function moderer(Utilisateur $user, Avi $avis): bool
    {
        return in_array($user->role, [
            RoleUtilisateur::SUPERADMIN,
            RoleUtilisateur::ADMIN,
        ]);
    }

    private function peutModerer(Utilisateur $user, Avi $avis): bool
    {
        // Le client peut voir son propre avis même s'il est masqué
        if ($user->role === RoleUtilisateur::CLIENT) {
            return $avis->client_id === $user->profilClient?->id;
        }

        return $this->repondre($user, $avis);
    }
