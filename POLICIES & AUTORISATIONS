<?php

namespace App\Policies;

use App\Models\Utilisateur;
use App\Models\Commande;
use App\Enums\RoleUtilisateur;

class CommandePolicy
{
    public function viewAny(Utilisateur $user): bool
    {
        return in_array($user->role, [
            RoleUtilisateur::SUPERADMIN,
            RoleUtilisateur::ADMIN,
            RoleUtilisateur::GERANT,
            RoleUtilisateur::LIVREUR,
            RoleUtilisateur::CLIENT,
        ]);
    }

    public function view(Utilisateur $user, Commande $commande): bool
    {
        // SuperAdmin : tout voir
        if ($user->role === RoleUtilisateur::SUPERADMIN) {
            return true;
        }

        // Admin : voir les commandes de ses restaurants
        if ($user->role === RoleUtilisateur::ADMIN) {
            return $user->profilAdmin?->restaurants()
                ->where('restaurants.id', $commande->restaurant_id)
                ->exists() ?? false;
        }

        // Gérant : voir les commandes de SON restaurant
        if ($user->role === RoleUtilisateur::GERANT) {
            return $commande->restaurant_id === $user->profilGerant?->restaurant_id;
        }

        // Livreur : voir les commandes qu'il livre
        if ($user->role === RoleUtilisateur::LIVREUR) {
            return $commande->livreur_id === $user->profilLivreur?->id;
        }

        // Client : voir SES commandes
        if ($user->role === RoleUtilisateur::CLIENT) {
            return $commande->client_id === $user->profilClient?->id;
        }

        return false;
    }

    public function modifierStatut(Utilisateur $user, Commande $commande): bool
    {
        // Gérant du restaurant
        if ($user->role === RoleUtilisateur::GERANT) {
            return $commande->restaurant_id === $user->profilGerant?->restaurant_id;
        }

        // Admin des restaurants concernés
        if ($user->role === RoleUtilisateur::ADMIN) {
            return $user->profilAdmin?->restaurants()
                ->where('restaurants.id', $commande->restaurant_id)
                ->exists() ?? false;
        }

        return $user->role === RoleUtilisateur::SUPERADMIN;
    }

    public function annuler(Utilisateur $user, Commande $commande): bool
    {
        // Le client peut annuler sa propre commande (si annulable)
        if ($user->role === RoleUtilisateur::CLIENT) {
            return $commande->client_id === $user->profilClient?->id && $commande->estAnnulable();
        }

        // Gérant/Admin/SuperAdmin
        return $this->modifierStatut($user, $commande);
    }

    public function rembourser(Utilisateur $user, Commande $commande): bool
    {
        return in_array($user->role, [
            RoleUtilisateur::SUPERADMIN,
            RoleUtilisateur::ADMIN,
            RoleUtilisateur::GERANT,
        ]) && $this->view($user, $commande);
    }
}
```

