### 4.1 `app/Policies/RestaurantPolicy.php`

```php
<?php

namespace App\Policies;

use App\Models\Utilisateur;
use App\Models\Restaurant;
use App\Enums\RoleUtilisateur;

class RestaurantPolicy
{
    /**
     * Qui peut voir la liste des restaurants ?
     */
    public function viewAny(Utilisateur $user): bool
    {
        return true; // Tout le monde peut voir les restaurants (public)
    }

    /**
     * Qui peut voir un restaurant spécifique ?
     */
    public function view(Utilisateur $user, Restaurant $restaurant): bool
    {
        return true; // Public
    }

    /**
     * Qui peut créer un restaurant ?
     */
    public function create(Utilisateur $user): bool
    {
        return $user->role === RoleUtilisateur::SUPERADMIN;
    }

    /**
     * Qui peut modifier un restaurant ?
     */
    public function update(Utilisateur $user, Restaurant $restaurant): bool
    {
        // SuperAdmin : toujours
        if ($user->role === RoleUtilisateur::SUPERADMIN) {
            return true;
        }

        // Admin : s'il est assigné au restaurant
        if ($user->role === RoleUtilisateur::ADMIN) {
            return $user->profilAdmin?->restaurants()
                ->where('restaurants.id', $restaurant->id)
                ->exists() ?? false;
        }

        // Gérant : si c'est SON restaurant
        if ($user->role === RoleUtilisateur::GERANT) {
            return $user->profilGerant?->restaurant_id === $restaurant->id;
        }

        return false;
    }

    /**
     * Qui peut supprimer un restaurant ?
     */
    public function delete(Utilisateur $user, Restaurant $restaurant): bool
    {
        return $user->role === RoleUtilisateur::SUPERADMIN;
    }

    /**
     * Qui peut gérer les horaires ?
     */
    public function gererHoraires(Utilisateur $user, Restaurant $restaurant): bool
    {
        return $this->update($user, $restaurant);
    }

    /**
     * Qui peut voir les statistiques d'un restaurant ?
     */
    public function voirStatistiques(Utilisateur $user, Restaurant $restaurant): bool
    {
        return $this->update($user, $restaurant);
    }
}
