## 🎁 10. TRAIT UTILE : `HasPermissions`

Crée un trait pour faciliter l'accès aux permissions dans les vues :

### `app/Traits/HasPermissionsHelper.php`

```php
<?php

namespace App\Traits;

trait HasPermissionsHelper
{
    /**
     * Vérifie si l'utilisateur peut gérer le restaurant courant
     */
    public function peutGererRestaurant($restaurant = null): bool
    {
        if (!$restaurant) {
            $restaurant = request()->route('restaurant');
        }

        if (!$restaurant) {
            return false;
        }

        return auth()->user()->can('update', $restaurant);
    }

    /**
     * Vérifie si l'utilisateur est le propriétaire de la ressource
     */
    public function estProprietaire($ressource): bool
    {
        $user = auth()->user();
        
        if (method_exists($ressource, 'client') && $ressource->client_id === $user->profilClient?->id) {
            return true;
        }
        
        if (method_exists($ressource, 'utilisateur') && $ressource->utilisateur_id === $user->id) {
            return true;
        }

        return false;
    }
}
```

