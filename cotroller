## 📦 12. API RESOURCES (EXEMPLES)

### 12.1 `app/Http/Resources/V1/RestaurantResource.php`

```php
<?php

namespace App\Http\Resources\V1;

use Illuminate\Http\Request;
use Illuminate\Http\Resources\Json\JsonResource;

class RestaurantResource extends JsonResource
{
    public function toArray(Request $request): array
    {
        return [
            'id' => $this->id,
            'nom' => $this->getTranslation('nom'),
            'nom_traductions' => $this->getTranslations('nom'),
            'slug' => $this->slug,
            'description' => $this->getTranslation('description'),
            'logo' => $this->logo ? asset('storage/' . $this->logo) : null,
            'image_couverture' => $this->image_couverture ? asset('storage/' . $this->image_couverture) : null,
            'telephone' => $this->telephone,
            'email' => $this->email,
            'adresse' => $this->adresse,
            'ville' => $this->ville,
            'latitude' => (float) $this->latitude,
            'longitude' => (float) $this->longitude,
            'note' => (float) $this->note,
            'total_avis' => $this->total_avis,
            'est_en_avant' => $this->est_en_avant,
            'livraison_activee' => $this->livraison_activee,
            'retrait_active' => $this->retrait_active,
            'sur_place_active' => $this->sur_place_active,
            'montant_minimum_commande' => (float) $this->montant_minimum_commande,
            'temps_preparation' => $this->temps_preparation,
            'est_ouvert' => $this->estOuvertMaintenant(),
            'distance' => $this->when($this->distance, fn() => round($this->distance, 2)),
            'images' => ImageResource::collection($this->whenLoaded('images')),
            'services' => $this->whenLoaded('services', fn() => $this->services->pluck('service')),
            'categories' => CategorieResource::collection($this->whenLoaded('categories')),
            'horaires' => HoraireResource::collection($this->whenLoaded('horaires')),
            'cree_le' => $this->cree_le?->toIso8601String(),
        ];
    }
}
