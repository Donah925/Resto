        if ($livraison->livreur_id) {
            return back()->with('error', 'Cette livraison a déjà été acceptée');
        }

        $this->deliveryService->assignerLivreur($livraison, $livreur);

        return redirect()
            ->route('livreur.livraisons.show', $livraison)
            ->with('success', 'Livraison acceptée');
    }

    public function changerStatut(Livraison $livraison, Request $request)
    {
        $livreur = $request->user()->profilLivreur;

        if ($livraison->livreur_id !== $livreur->id) {
            abort(403, 'Vous n\'êtes pas assigné à cette livraison');
        }

        $request->validate([
            'statut' => 'required|in:en_route_restaurant,recuperee,en_livraison,livree',
        ]);

        $this->deliveryService->changerStatut($livraison, $request->statut);

        return back()->with('success', 'Statut mis à jour');
    }

    public function majLocalisation(Livraison $livraison, Request $request)
    {
        $livreur = $request->user()->profilLivreur;

        $request->validate([
            'latitude' => 'required|numeric|between:-90,90',
            'longitude' => 'required|numeric|between:-180,180',
            'vitesse' => 'nullable|numeric',
            'direction' => 'nullable|numeric',
        ]);

        // Mettre à jour la position du livreur
        $livreur->mettreAJourLocalisation($request->latitude, $request->longitude);

        // Enregistrer le suivi
        $livraison->suivis()->create([
            'livreur_id' => $livreur->id,
            'latitude' => $request->latitude,
            'longitude' => $request->longitude,
            'vitesse' => $request->vitesse,
            'direction' => $request->direction,
        ]);

        // Broadcast en temps réel via WebSocket
        broadcast(new \App\Events\LivraisonPositionUpdated($livraison->id, [
            'lat' => $request->latitude,
            'lng' => $request->longitude,
        ]))->toOthers();

        return response()->json(['message' => 'Position mise à jour']);
    }

    public function ajouterPreuve(Livraison $livraison, Request $request)
    {
        $livreur = $request->user()->profilLivreur;

        $request->validate([
            'type_preuve' => 'required|in:photo,signature,code,gps',
            'photo' => 'required_if:type_preuve,photo|image|max:5120',
            'signature' => 'required_if:type_preuve,signature|string',
            'code' => 'required_if:type_preuve,code|string',
            'nom_destinataire' => 'nullable|string|max:255',
        ]);

        $donnees = [
            'type_preuve' => $request->type_preuve,
            'nom_destinataire' => $request->nom_destinataire,
            'latitude' => $livreur->latitude_courante,
            'longitude' => $livreur->longitude_courante,
        ];

        if ($request->type_preuve === 'photo') {
            $donnees['chemin_fichier'] = $this->uploadPreuve($request->file('photo'));
        } elseif ($request->type_preuve === 'signature') {
            $donnees['signature_base64'] = $request->signature;
        } elseif ($request->type_preuve === 'code') {
            $donnees['code_confirmation'] = $request->code;
        }

        $preuve = $livraison->preuve()->create($donnees);

        // Marquer la livraison comme livrée
        $this->deliveryService->marquerLivree($livraison, $preuve);

        return back()->with('success', 'Livraison terminée');
    }

    private function uploadPreuve($file): string
    {
        return $file->store('preuves-livraison', 'public');
    }
