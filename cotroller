### 12.2 `app/Http/Resources/V1/CommandeResource.php`

```php
<?php

namespace App\Http\Resources\V1;

use Illuminate\Http\Request;
use Illuminate\Http\Resources\Json\JsonResource;

class CommandeResource extends JsonResource
{
    public function toArray(Request $request): array
    {
        return [
            'id' => $this->id,
            'numero' => $this->numero,
            'type_commande' => $this->type_commande->value,
            'type_commande_label' => match($this->type_commande->value) {
                'livraison' => 'Livraison',
                'retrait' => 'Retrait',
                'sur_place' => 'Sur place',
            },
            'statut' => $this->statut->value,
            'statut_label' => $this->statut->label(),
            'statut_color' => $this->statut->color(),
            'sous_total' => (float) $this->sous_total,
            'montant_tva' => (float) $this->montant_tva,
            'frais_livraison' => (float) $this->frais_livraison,
            'montant_reduction' => (float) $this->montant_reduction,
            'montant_total' => (float) $this->montant_total,
            'notes_client' => $this->notes_client,
            'temps_preparation_estime' => $this->temps_preparation_estime,
            'restaurant' => new RestaurantResource($this->whenLoaded('restaurant')),
            'lignes' => LigneCommandeResource::collection($this->whenLoaded('lignes')),
            'adresse_livraison' => new AdresseResource($this->whenLoaded('adresseLivraison')),
            'livraison' => new LivraisonResource($this->whenLoaded('livraison')),
            'paiement' => new PaiementResource($this->whenLoaded('paiement')),
            'cree_le' => $this->cree_le?->toIso8601String(),
        ];
    }
}
