    {
        $livreur = $request->user()->profilLivreur;

        $livraisons = Livraison::enAttente()
            ->with(['commande.restaurant', 'commande.adresseLivraison'])
            ->whereHas('commande.restaurant', function($q) use ($livreur) {
                // Filtrer par zone du livreur
                if ($livreur->zone_geojson) {
                    $q->whereRaw("ST_Contains(ST_GeomFromGeoJSON(?), ST_Point(longitude, latitude))", [
                        json_encode($livreur->zone_geojson)
                    ]);
                }
            })
            ->get();

        return view('livreur.livraisons.disponibles', compact('livraisons'));
