## 💰 3. MODULE PAIEMENT (Architecture Gateway)

### 3.1 `app/Services/Payment/Contracts/PaymentGatewayInterface.php`

```php
<?php

namespace App\Services\Payment\Contracts;

use App\Models\Paiement;
use App\Models\Commande;

interface PaymentGatewayInterface
{
    /**
     * Nom unique du prestataire
     */
    public function getName(): string;

    /**
     * Initie un paiement et retourne les données nécessaires au frontend
     */
    public function initiate(Commande $commande, array $options = []): array;

    /**
     * Vérifie le statut d'un paiement auprès du prestataire
     */
    public function checkStatus(Paiement $paiement): string;

    /**
     * Rembourse un paiement
     */
    public function refund(Paiement $paiement, float $amount = null, string $reason = ''): bool;

    /**
     * Traite un webhook entrant
     */
    public function handleWebhook(array $payload, array $headers = []): void;

    /**
     * Vérifie la signature d'un webhook
     */
    public function verifyWebhookSignature(array $payload, array $headers): bool;
}
```

