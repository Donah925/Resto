### 3.5 `app/Services/Payment/Gateways/WaveGateway.php`

```php
<?php

namespace App\Services\Payment\Gateways;

use App\Models\Commande;
use App\Models\Paiement;
use App\Services\Payment\Contracts\PaymentGatewayInterface;
use Illuminate\Support\Facades\Http;
use Illuminate\Support\Str;

class WaveGateway implements PaymentGatewayInterface
{
    private string $baseUrl;
    private string $apiKey;

    public function __construct()
    {
        $this->baseUrl = config('services.wave.base_url');
        $this->apiKey = config('services.wave.api_key');
    }

    public function getName(): string
    {
        return 'wave';
    }

    public function initiate(Commande $commande, array $options = []): array
    {
        $telephone = $options['telephone_mobile_money'] ?? $commande->client->utilisateur->telephone;

        $response = Http::withHeaders([
            'Authorization' => "Bearer {$this->apiKey}",
            'Content-Type' => 'application/json',
        ])->post("{$this->baseUrl}/v1/transactions", [
            'amount' => (int) round($commande->montant_total),
            'currency' => $commande->restaurant->devise ?? 'XOF',
            'purpose' => "Commande #{$commande->numero}",
            'phone_number' => $telephone,
            'merchant_reference' => $commande->numero,
            'notification_url' => route('api.v1.webhooks.wave'),
        ]);

        $paiement = Paiement::create([
            'commande_id' => $commande->id,
            'client_id' => $commande->client_id,
            'reference_transaction' => 'PAY-WAVE-' . strtoupper(Str::random(12)),
            'reference_prestataire' => $response->json('id') ?? null,
            'methode_paiement' => 'wave',
            'prestataire' => 'wave',
            'montant' => $commande->montant_total,
            'devise' => $commande->restaurant->devise ?? 'XOF',
            'telephone_mobile_money' => $telephone,
            'statut' => 'en_attente',
        ]);

        return [
            'paiement_id' => $paiement->id,
            'transaction_id' => $response->json('id'),
            'payment_link' => $response->json('payment_link'), // Lien pour le client
            'status' => $response->json('status'),
        ];
    }

    public function checkStatus(Paiement $paiement): string
    {
        $response = Http::withHeaders([
            'Authorization' => "Bearer {$this->apiKey}",
        ])->get("{$this->baseUrl}/v1/transactions/{$paiement->reference_prestataire}");

        if ($response->failed()) return 'en_attente';

        return match($response->json('status')) {
            'successful' => 'reussi',
            'failed' => 'echoue',
            'cancelled' => 'annule',
            default => 'en_attente',
        };
    }

    public function refund(Paiement $paiement, float $amount = null, string $reason = ''): bool
    {
        $response = Http::withHeaders([
            'Authorization' => "Bearer {$this->apiKey}",
        ])->post("{$this->baseUrl}/v1/refunds", [
            'transaction_id' => $paiement->reference_prestataire,
            'amount' => (int) round($amount ?? $paiement->montant),
            'reason' => $reason ?: 'Remboursement',
        ]);

        if ($response->successful()) {
            $paiement->update(['statut' => 'rembourse']);
            return true;
        }

        return false;
    }

    public function handleWebhook(array $payload, array $headers = []): void
    {
        $transactionId = $payload['transaction_id'] ?? null;
        $status = $payload['status'] ?? null;

        $paiement = Paiement::where('reference_prestataire', $transactionId)->first();
        if (!$paiement) return;

        match($status) {
            'successful' => $paiement->update([
                'statut' => 'reussi',
                'heure_paiement' => now(),
            ]),
            'failed', 'cancelled' => $paiement->update(['statut' => 'echoue']),
            default => null,
        };

        if ($status === 'successful') {
            $paiement->commande->changerStatut(\App\Enums\StatutCommande::CONFIRMEE);
        }
    }

    public function verifyWebhookSignature(array $payload, array $headers): bool
    {
        $signature = $headers['Wave-Signature'] ?? '';
        $computed = hash_hmac('sha256', json_encode($payload), config('services.wave.webhook_secret'));
        return hash_equals($computed, $signature);
    }
}
