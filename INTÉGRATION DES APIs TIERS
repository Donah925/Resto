### Mise à jour de `PaymentService` pour utiliser le Factory

```php
// Dans app/Services/PaymentService.php

use App\Services\Payment\PaymentGatewayFactory;

public function initierPaiement(Commande $commande, array $donnees): Paiement
{
    $methode = MethodePaiement::from($donnees['methode_paiement']);
    
    // Paiements internes (pas de gateway externe)
    if (in_array($methode, [
        MethodePaiement::PORTEFEUILLE,
        MethodePaiement::CARTE_CADEAU,
        MethodePaiement::ESPECES_LIVRAISON,
    ])) {
        return $this->initierPaiementInterne($commande, $methode, $donnees);
    }

    // Paiements via gateway externe
    $gateway = PaymentGatewayFactory::create($methode);
    $result = $gateway->initiate($commande, $donnees);

    return Paiement::find($result['paiement_id']);
}
