```php
<?php

namespace App\Services\Translation;

use Illuminate\Support\Facades\Http;
use Illuminate\Support\Facades\Cache;

class DeepLService
{
    private string $apiKey;
    private string $baseUrl;

    public function __construct()
    {
        $this->apiKey = config('services.deepl.api_key');
        // DeepL a 2 URLs selon le type de clé (free ou pro)
        $this->baseUrl = str_ends_with($this->apiKey, ':fx')
            ? 'https://api-free.deepl.com/v2'
            : 'https://api.deepl.com/v2';
    }

    /**
     * Traduit un texte
     */
    public function translate(string $text, string $targetLang, ?string $sourceLang = null): string
    {
        $cacheKey = 'deepl_' . md5($text . $targetLang . $sourceLang);
        
        return Cache::remember($cacheKey, 86400 * 7, function () use ($text, $targetLang, $sourceLang) {
            $params = [
                'text' => [$text],
                'target_lang' => strtoupper($targetLang),
                'auth_key' => $this->apiKey,
            ];

            if ($sourceLang) {
                $params['source_lang'] = strtoupper($sourceLang);
            }

            $response = Http::asForm()->post("{$this->baseUrl}/translate", $params);

            if ($response->failed()) {
                \Log::error('Erreur DeepL', ['response' => $response->body()]);
                return $text;
            }

            return $response->json('translations.0.text') ?? $text;
        });
    }

    /**
     * Traduit un tableau JSON multi-langue
     */
    public function translateArray(array $data, string $sourceLang, array $targetLangs): array
    {
        $result = $data;
        
        foreach ($targetLangs as $targetLang) {
            if (isset($result[$targetLang])) continue;
            
            $sourceText = $data[$sourceLang] ?? reset($data);
            $result[$targetLang] = $this->translate($sourceText, $targetLang, $sourceLang);
        }
        
        return $result;
    }

    /**
     * Traduit automatiquement tous les champs traduisibles d'un modèle
     */
    public function translateModel($model, array $translatableFields, string $sourceLang = 'fr', array $targetLangs = ['en']): void
    {
        foreach ($translatableFields as $field) {
            $currentValue = $model->getAttributes()[$field] ?? null;
            if (!$currentValue) continue;

            $data = is_string($currentValue) ? json_decode($currentValue, true) : $currentValue;
            if (!is_array($data)) continue;

            $translated = $this->translateArray($data, $sourceLang, $targetLangs);
            $model->{$field} = $translated;
        }

        $model->save();
    }

    /**
     * Vérifie les quotas DeepL
     */
    public function getUsage(): array
    {
        $response = Http::get("{$this->baseUrl}/usage", [
            'auth_key' => $this->apiKey,
        ]);

        return $response->json();
    }
}
