        $headers = array_map(fn($v) => $v[0] ?? '', $headers);

        $gateway = PaymentGatewayFactory::create(MethodePaiement::PAYPAL);

        if (!$gateway->verifyWebhookSignature($payload, $headers)) {
            return response()->json(['error' => 'Invalid signature'], 401);
        }

        $gateway->handleWebhook($payload, $headers);

        return response()->json(['status' => 'ok']);
    }
}
