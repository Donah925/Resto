### 3.3 `app/Services/Payment/Gateways/StripeGateway.php`

```php
<?php

namespace App\Services\Payment\Gateways;

use App\Models\Commande;
use App\Models\Paiement;
use App\Services\Payment\Contracts\PaymentGatewayInterface;
use Stripe\PaymentIntent;
use Stripe\Refund;
use Stripe\Webhook;
use Illuminate\Support\Str;

class StripeGateway implements PaymentGatewayInterface
{
    public function __construct()
    {
        \Stripe\Stripe::setApiKey(config('services.stripe.secret'));
    }

    public function getName(): string
    {
        return 'stripe';
    }

    public function initiate(Commande $commande, array $options = []): array
    {
        $intent = PaymentIntent::create([
            'amount' => (int) round($commande->montant_total * 100), // centimes
            'currency' => strtolower($commande->restaurant->devise ?? 'xof'),
            'description' => "Commande #{$commande->numero}",
            'metadata' => [
                'commande_id' => $commande->id,
                'commande_numero' => $commande->numero,
                'client_id' => $commande->client_id,
                'restaurant_id' => $commande->restaurant_id,
            ],
            'automatic_payment_methods' => ['enabled' => true],
        ]);

        // Créer l'enregistrement Paiement
        $paiement = Paiement::create([
            'commande_id' => $commande->id,
            'client_id' => $commande->client_id,
            'reference_transaction' => 'PAY-' . strtoupper(Str::random(16)),
            'reference_prestataire' => $intent->id,
            'methode_paiement' => $options['methode'] ?? 'carte_bancaire',
            'prestataire' => 'stripe',
            'montant' => $commande->montant_total,
            'devise' => $commande->restaurant->devise ?? 'XOF',
            'statut' => 'en_attente',
            'metadata' => ['client_secret' => $intent->client_secret],
        ]);

        return [
            'paiement_id' => $paiement->id,
            'client_secret' => $intent->client_secret,
            'payment_intent_id' => $intent->id,
        ];
    }

    public function checkStatus(Paiement $paiement): string
    {
        $intent = PaymentIntent::retrieve($paiement->reference_prestataire);

        return match($intent->status) {
            'succeeded' => 'reussi',
            'processing', 'requires_action', 'requires_confirmation' => 'en_attente',
            'canceled' => 'annule',
            'requires_payment_method' => 'echoue',
            default => 'en_attente',
        };
    }

    public function refund(Paiement $paiement, float $amount = null, string $reason = ''): bool
    {
        try {
            $refund = Refund::create([
                'payment_intent' => $paiement->reference_prestataire,
                'amount' => $amount ? (int) round($amount * 100) : null,
                'metadata' => ['reason' => $reason],
            ]);

            $paiement->update([
                'statut' => $amount && $amount < $paiement->montant 
                    ? 'rembourse_partiellement' 
                    : 'rembourse',
                'metadata' => array_merge($paiement->metadata ?? [], ['refund_id' => $refund->id]),
            ]);

            return true;
        } catch (\Exception $e) {
            \Log::error('Erreur remboursement Stripe', ['error' => $e->getMessage()]);
            return false;
        }
    }

    public function handleWebhook(array $payload, array $headers = []): void
    {
        $event = $payload['type'] ?? null;
        $data = $payload['data']['object'] ?? [];

        match($event) {
            'payment_intent.succeeded' => $this->onPaymentSucceeded($data),
            'payment_intent.payment_failed' => $this->onPaymentFailed($data),
            'charge.refunded' => $this->onRefunded($data),
            default => \Log::info("Stripe webhook non géré: {$event}"),
        };
    }

    public function verifyWebhookSignature(array $payload, array $headers): bool
    {
        try {
            $sigHeader = $headers['Stripe-Signature'] ?? '';
            Webhook::constructEvent(
                json_encode($payload),
                $sigHeader,
                config('services.stripe.webhook_secret')
            );
            return true;
        } catch (\Exception $e) {
            \Log::error('Signature Stripe invalide', ['error' => $e->getMessage()]);
            return false;
        }
    }

    private function onPaymentSucceeded(array $data): void
    {
        $paiement = Paiement::where('reference_prestataire', $data['id'])->first();
        if (!$paiement) return;

        $paiement->update([
            'statut' => 'reussi',
            'heure_paiement' => now(),
        ]);

        // Confirmer la commande
        $paiement->commande->changerStatut(\App\Enums\StatutCommande::CONFIRMEE);

        // Émettre l'événement
        event(new \App\Events\StatutCommandeModifie(
            $paiement->commande,
            \App\Enums\StatutCommande::EN_ATTENTE,
            \App\Enums\StatutCommande::CONFIRMEE
        ));
    }

    private function onPaymentFailed(array $data): void
    {
        $paiement = Paiement::where('reference_prestataire', $data['id'])->first();
        if (!$paiement) return;

        $paiement->update(['statut' => 'echoue']);
    }

    private function onRefunded(array $data): void
    {
        $paiement = Paiement::where('reference_prestataire', $data['payment_intent'] ?? '')->first();
        if ($paiement) {
            $paiement->update(['statut' => 'rembourse']);
        }
    }
}
```

### 3.4 `app/Services/Payment/Gateways/MtnMomoGateway.php` (MTN Mobile Money)

```php
<?php

namespace App\Services\Payment\Gateways;

use App\Models\Commande;
use App\Models\Paiement;
use App\Services\Payment\Contracts\PaymentGatewayInterface;
use Illuminate\Support\Facades\Http;
use Illuminate\Support\Str;

class MtnMomoGateway implements PaymentGatewayInterface
{
    private string $baseUrl;
    private string $subscriptionKey;
    private string $userId;
    private string $apiKey;

    public function __construct()
    {
        $this->baseUrl = config('services.mtn_momo.base_url');
        $this->subscriptionKey = config('services.mtn_momo.subscription_key');
        $this->userId = config('services.mtn_momo.user_id');
        $this->apiKey = config('services.mtn_momo.api_key');
    }

    public function getName(): string
    {
        return 'mtn';
    }

    public function initiate(Commande $commande, array $options = []): array
    {
        $referenceId = (string) Str::uuid();
        $telephone = $options['telephone_mobile_money'] ?? $commande->client->utilisateur->telephone;

        // Normaliser le numéro (format international)
        $telephone = $this->normaliserTelephone($telephone);

        // Étape 1 : Créer la requête de paiement
        $response = Http::withHeaders([
            'X-Reference-Id' => $referenceId,
            'X-Target-Environment' => config('services.mtn_momo.target_environment'),
            'X-Subscription-Key' => $this->subscriptionKey,
            'Authorization' => 'Basic ' . base64_encode("{$this->userId}:{$this->apiKey}"),
        ])->post("{$this->baseUrl}/collection/v1_0/requesttopay", [
            'amount' => number_format($commande->montant_total, 0, '', ''),
            'currency' => $commande->restaurant->devise ?? 'XOF',
            'externalId' => $commande->numero,
            'payer' => [
                'partyIdType' => 'MSISDN',
                'partyId' => $telephone,
            ],
            'payerMessage' => "Paiement commande #{$commande->numero}",
            'payeeNote' => 'RestoApp',
        ]);

        // Créer l'enregistrement Paiement
        $paiement = Paiement::create([
            'commande_id' => $commande->id,
            'client_id' => $commande->client_id,
            'reference_transaction' => 'PAY-MTN-' . strtoupper(Str::random(12)),
            'reference_prestataire' => $referenceId,
            'methode_paiement' => 'mtn_mobile_money',
            'prestataire' => 'mtn',
            'montant' => $commande->montant_total,
            'devise' => $commande->restaurant->devise ?? 'XOF',
            'telephone_mobile_money' => $telephone,
            'statut' => 'en_attente',
            'metadata' => [
                'response_status' => $response->status(),
                'response_body' => $response->json(),
            ],
        ]);

        return [
            'paiement_id' => $paiement->id,
            'reference_id' => $referenceId,
            'status_code' => $response->status(),
            // Le client doit approuver le paiement sur son téléphone via USSD
            'instructions' => "Un message USSD a été envoyé au {$telephone}. Veuillez composer le code pour approuver.",
        ];
    }

    public function checkStatus(Paiement $paiement): string
    {
        $response = Http::withHeaders([
            'X-Subscription-Key' => $this->subscriptionKey,
            'X-Target-Environment' => config('services.mtn_momo.target_environment'),
            'Authorization' => 'Basic ' . base64_encode("{$this->userId}:{$this->apiKey}"),
        ])->get("{$this->baseUrl}/collection/v1_0/requesttopay/{$paiement->reference_prestataire}");

        if ($response->failed()) {
            return 'en_attente';
        }

        $status = $response->json()['status'] ?? null;

        return match($status) {
            'SUCCESSFUL' => 'reussi',
            'FAILED' => 'echoue',
            'PENDING' => 'en_attente',
            default => 'en_attente',
        };
    }

    public function refund(Paiement $paiement, float $amount = null, string $reason = ''): bool
    {
        $referenceId = (string) Str::uuid();

        $response = Http::withHeaders([
            'X-Reference-Id' => $referenceId,
            'X-Subscription-Key' => $this->subscriptionKey,
            'X-Target-Environment' => config('services.mtn_momo.target_environment'),
            'Authorization' => 'Basic ' . base64_encode("{$this->userId}:{$this->apiKey}"),
        ])->post("{$this->baseUrl}/collection/v1_0/refund", [
            'amount' => number_format($amount ?? $paiement->montant, 0, '', ''),
            'currency' => $paiement->devise,
            'externalId' => $paiement->reference_transaction,
            'payerMessage' => $reason ?: 'Remboursement',
            'payeeNote' => 'RestoApp',
        ]);

        if ($response->successful()) {
            $paiement->update(['statut' => 'rembourse']);
            return true;
        }

        return false;
    }

    public function handleWebhook(array $payload, array $headers = []): void
    {
        $referenceId = $payload['referenceId'] ?? null;
        $status = $payload['status'] ?? null;
        $amount = $payload['amount'] ?? null;

        $paiement = Paiement::where('reference_prestataire', $referenceId)->first();
        if (!$paiement) {
            \Log::warning('Webhook MTN: paiement introuvable', $payload);
            return;
        }

        match($status) {
            'SUCCESSFUL' => $paiement->update([
                'statut' => 'reussi',
                'heure_paiement' => now(),
            ]),
            'FAILED' => $paiement->update(['statut' => 'echoue']),
            default => null,
        };

        if ($status === 'SUCCESSFUL') {
            $paiement->commande->changerStatut(\App\Enums\StatutCommande::CONFIRMEE);
        }
    }

    public function verifyWebhookSignature(array $payload, array $headers): bool
    {
        // MTN MoMo n'a pas de signature HMAC standard, on vérifie via l'IP source
        $allowedIps = config('services.mtn_momo.webhook_ips', []);
        if (empty($allowedIps)) return true;

        return in_array(request()->ip(), $allowedIps);
    }

    private function normaliserTelephone(string $telephone): string
    {
        // Retirer tous les caractères non numériques
        $numero = preg_replace('/[^0-9]/', '', $telephone);
        
        // Si commence par 00, remplacer par +
        if (str_starts_with($numero, '00')) {
            $numero = substr($numero, 2);
        }
        
        // Si commence par +, retirer le +
        $numero = ltrim($numero, '+');
        
        // Si commence par 225 (Côte d'Ivoire), garder
        if (str_starts_with($numero, '225')) {
            return substr($numero, 3);
        }
        
        return $numero;
    }
}
