<?php

namespace App\Services\Payment\Gateways;

use App\Models\Commande;
use App\Models\Paiement;
use App\Services\Payment\Contracts\PaymentGatewayInterface;
use Illuminate\Support\Facades\Http;
use Illuminate\Support\Str;

class PayPalGateway implements PaymentGatewayInterface
{
    private string $baseUrl;
    private ?string $accessToken = null;

    public function __construct()
    {
        $mode = config('services.paypal.mode', 'sandbox');
        $this->baseUrl = $mode === 'live' 
            ? 'https://api-m.paypal.com' 
            : 'https://api-m.sandbox.paypal.com';
    }

    public function getName(): string
    {
        return 'paypal';
    }

    private function getAccessToken(): string
    {
        if ($this->accessToken) return $this->accessToken;

        $response = Http::withBasicAuth(
            config('services.paypal.client_id'),
            config('services.paypal.secret')
        )->asForm()->post("{$this->baseUrl}/v1/oauth2/token", [
            'grant_type' => 'client_credentials',
        ]);

        $this->accessToken = $response->json('access_token');
        return $this->accessToken;
    }

    public function initiate(Commande $commande, array $options = []): array
    {
        $response = Http::withToken($this->getAccessToken())
            ->withHeaders(['PayPal-Request-Id' => Str::uuid()->toString()])
            ->post("{$this->baseUrl}/v2/checkout/orders", [
                'intent' => 'CAPTURE',
                'purchase_units' => [[
                    'reference_id' => $commande->numero,
                    'description' => "Commande #{$commande->numero}",
                    'amount' => [
                        'currency_code' => 'USD',
                        'value' => number_format($commande->montant_total / 600, 2, '.', ''), // Conversion XOF → USD approximative
                    ],
                ]],
                'application_context' => [
                    'return_url' => route('client.commandes.show', $commande) . '?paypal=success',
                    'cancel_url' => route('client.commandes.show', $commande) . '?paypal=cancel',
                    'brand_name' => 'RestoApp',
                    'user_action' => 'PAY_NOW',
                ],
            ]);

        $orderData = $response->json();
        $approvalLink = collect($orderData['links'] ?? [])
            ->firstWhere('rel', 'approve')['href'] ?? null;

        $paiement = Paiement::create([
            'commande_id' => $commande->id,
            'client_id' => $commande->client_id,
            'reference_transaction' => 'PAY-PAYPAL-' . strtoupper(Str::random(12)),
            'reference_prestataire' => $orderData['id'] ?? null,
            'methode_paiement' => 'paypal',
            'prestataire' => 'paypal',
            'montant' => $commande->montant_total,
            'devise' => 'USD',
            'email_paypal' => $options['email_paypal'] ?? null,
            'statut' => 'en_attente',
            'metadata' => ['approval_link' => $approvalLink],
        ]);

        return [
            'paiement_id' => $paiement->id,
            'order_id' => $orderData['id'],
            'approval_link' => $approvalLink,
        ];
    }

    public function checkStatus(Paiement $paiement): string
    {
        $response = Http::withToken($this->getAccessToken())
            ->get("{$this->baseUrl}/v2/checkout/orders/{$paiement->reference_prestataire}");

        if ($response->failed()) return 'en_attente';

        return match($response->json('status')) {
            'COMPLETED' => 'reussi',
            'VOIDED', 'DECLINED' => 'echoue',
            'CREATED', 'SAVED', 'PAYER_ACTION_REQUIRED' => 'en_attente',
            default => 'en_attente',
        };
    }

    public function refund(Paiement $paiement, float $amount = null, string $reason = ''): bool
    {
        // Récupérer le capture_id
        $order = Http::withToken($this->getAccessToken())
            ->get("{$this->baseUrl}/v2/checkout/orders/{$paiement->reference_prestataire}")
            ->json();
        
        $captureId = $order['purchase_units'][0]['payments']['captures'][0]['id'] ?? null;
        if (!$captureId) return false;

        $data = [];
        if ($amount) {
            $data['amount'] = [
                'value' => number_format($amount / 600, 2, '.', ''),
                'currency_code' => 'USD',
            ];
        }

        $response = Http::withToken($this->getAccessToken())
            ->post("{$this->baseUrl}/v2/payments/captures/{$captureId}/refund", $data);

        if ($response->successful()) {
            $paiement->update(['statut' => $amount && $amount < $paiement->montant ? 'rembourse_partiellement' : 'rembourse']);
            return true;
        }

        return false;
    }

    public function handleWebhook(array $payload, array $headers = []): void
    {
        $eventType = $payload['event_type'] ?? null;
        $resource = $payload['resource'] ?? [];

        match($eventType) {
            'CHECKOUT.ORDER.APPROVED' => $this->captureOrder($resource['id']),
            'PAYMENT.CAPTURE.COMPLETED' => $this->onCaptureCompleted($resource),
            'PAYMENT.CAPTURE.REFUNDED' => $this->onRefunded($resource),
            default => null,
        };
    }

    public function verifyWebhookSignature(array $payload, array $headers): bool
    {
        $response = Http::withToken($this->getAccessToken())
            ->post("{$this->baseUrl}/v1/notifications/verify-webhook-signature", [
                'auth_algo' => $headers['PAYPAL-AUTH-ALGO'] ?? '',
                'cert_url' => $headers['PAYPAL-CERT-URL'] ?? '',
                'transmission_id' => $headers['PAYPAL-TRANSMISSION-ID'] ?? '',
                'transmission_sig' => $headers['PAYPAL-TRANSMISSION-SIG'] ?? '',
                'transmission_time' => $headers['PAYPAL-TRANSMISSION-TIME'] ?? '',
                'webhook_id' => config('services.paypal.webhook_id'),
                'webhook_event' => $payload,
            ]);

        return $response->json('verification_status') === 'SUCCESS';
    }

    private function captureOrder(string $orderId): void
    {
        Http::withToken($this->getAccessToken())
            ->post("{$this->baseUrl}/v2/checkout/orders/{$orderId}/capture");
    }

    private function onCaptureCompleted(array $resource): void
    {
        $orderId = $resource['supplementary_data']['related_ids']['order_id'] ?? null;
        $paiement = Paiement::where('reference_prestataire', $orderId)->first();
        
        if ($paiement) {
            $paiement->update(['statut' => 'reussi', 'heure_paiement' => now()]);
            $paiement->commande->changerStatut(\App\Enums\StatutCommande::CONFIRMEE);
        }
    }

    private function onRefunded(array $resource): void
    {
        // Logique de gestion du remboursement
    }
}
