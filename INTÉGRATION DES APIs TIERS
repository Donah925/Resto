<?php

namespace App\Services\Payment;

use App\Enums\MethodePaiement;
use App\Services\Payment\Contracts\PaymentGatewayInterface;
use App\Services\Payment\Gateways\{
    StripeGateway,
    MtnMomoGateway,
    MoovMoneyGateway,
    OrangeMoneyGateway,
    WaveGateway,
    PayPalGateway,
    PayeerGateway,
    PayoneerGateway
};

class PaymentGatewayFactory
{
    public static function create(MethodePaiement $methode): PaymentGatewayInterface
    {
        return match($methode) {
            MethodePaiement::CARTE_BANCAIRE => new StripeGateway(),
            MethodePaiement::MTN_MOBILE_MONEY => new MtnMomoGateway(),
            MethodePaiement::MOOV_MONEY => new MoovMoneyGateway(),
            MethodePaiement::ORANGE_MONEY => new OrangeMoneyGateway(),
            MethodePaiement::WAVE => new WaveGateway(),
            MethodePaiement::PAYPAL => new PayPalGateway(),
            MethodePaiement::PAYEER => new PayeerGateway(),
            MethodePaiement::PAYONEER => new PayoneerGateway(),
            default => throw new \InvalidArgumentException("Méthode de paiement non supportée: {$methode->value}"),
        };
    }
}
