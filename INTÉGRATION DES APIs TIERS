<?php

namespace App\Services\Search;

use App\Models\Produit;
use App\Models\Restaurant;
use Meilisearch\Client;

class MeilisearchService
{
    private Client $client;

    public function __construct()
    {
        $this->client = new Client(
            config('scout.meilisearch.host'),
            config('scout.meilisearch.key')
        );
    }

    /**
     * Recherche multi-critères (produits + restaurants)
     */
    public function search(string $query, array $options = []): array
    {
        $results = [
            'restaurants' => [],
            'produits' => [],
        ];

        // Recherche restaurants
        $restaurantsIndex = $this->client->index('restaurants');
        $restaurantsResults = $restaurantsIndex->search($query, [
            'limit' => $options['limit'] ?? 10,
            'filter' => $this->buildRestaurantFilters($options),
        ]);
        $results['restaurants'] = $restaurantsResults->getHits();

        // Recherche produits
        $produitsIndex = $this->client->index('produits');
        $produitsResults = $produitsIndex->search($query, [
            'limit' => $options['limit'] ?? 20,
            'filter' => $this->buildProduitFilters($options),
        ]);
        $results['produits'] = $produitsResults->getHits();

        return $results;
    }

    /**
     * Recherche de produits avec filtres avancés
     */
    public function searchProduits(string $query, array $filters = []): array
    {
        $index = $this->client->index('produits');
        
        $searchFilters = [];
        
        if (!empty($filters['restaurant_id'])) {
            $searchFilters[] = "restaurant_id = {$filters['restaurant_id']}";
        }
        if (!empty($filters['vegetarien'])) {
            $searchFilters[] = 'est_vegetarien = true';
        }
        if (!empty($filters['vegan'])) {
            $searchFilters[] = 'est_vegan = true';
        }
        if (!empty($filters['halal'])) {
            $searchFilters[] = 'est_halal = true';
        }
        if (!empty($filters['sans_gluten'])) {
            $searchFilters[] = 'est_sans_gluten = true';
        }
        if (!empty($filters['prix_min'])) {
            $searchFilters[] = "prix_base >= {$filters['prix_min']}";
        }
        if (!empty($filters['prix_max'])) {
            $searchFilters[] = "prix_base <= {$filters['prix_max']}";
        }

        $results = $index->search($query, [
            'filter' => $searchFilters,
            'limit' => $filters['limit'] ?? 50,
            'sort' => $filters['sort'] ?? ['prix_base:asc'],
        ]);

        return $results->getHits();
    }

    /**
     * Configure les indexes (à lancer une fois)
     */
    public function configureIndexes(): void
    {
        // Index restaurants
        $restaurantsIndex = $this->client->index('restaurants');
        $restaurantsIndex->updateFilterableAttributes([
            'ville', 'statut', 'est_en_avant', 'livraison_activee',
            'note', 'latitude', 'longitude',
        ]);
        $restaurantsIndex->updateSortableAttributes(['note', 'cree_le']);
        $restaurantsIndex->updateSearchableAttributes([
            'nom', 'description', 'ville', 'adresse',
        ]);

        // Index produits
        $produitsIndex = $this->client->index('produits');
        $produitsIndex->updateFilterableAttributes([
            'restaurant_id', 'categorie_id', 'est_disponible',
            'est_vegetarien', 'est_vegan', 'est_halal', 'est_sans_gluten', 'est_epice',
            'prix_base', 'est_en_avant', 'est_nouveau',
        ]);
        $produitsIndex->updateSortableAttributes(['prix_base', 'ordre_tri', 'cree_le']);
        $produitsIndex->updateSearchableAttributes([
            'nom', 'description', 'tags',
        ]);
    }

    private function buildRestaurantFilters(array $options): array
    {
        $filters = ['statut = actif'];
        if (!empty($options['ville'])) {
            $filters[] = "ville = '{$options['ville']}'";
        }
        if (!empty($options['livraison'])) {
            $filters[] = 'livraison_activee = true';
        }
        if (!empty($options['note_min'])) {
            $filters[] = "note >= {$options['note_min']}";
        }
        return $filters;
    }

    private function buildProduitFilters(array $options): array
    {
        $filters = ['est_disponible = true'];
        if (!empty($options['restaurant_id'])) {
            $filters[] = "restaurant_id = {$options['restaurant_id']}";
        }
        return $filters;
    }
}
