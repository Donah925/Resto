<?php

namespace App\Services\Maps;

use Illuminate\Support\Facades\Http;
use Illuminate\Support\Facades\Cache;

class GoogleMapsService
{
    private string $apiKey;
    private string $baseUrl = 'https://maps.googleapis.com/maps/api';

    public function __construct()
    {
        $this->apiKey = config('services.google.maps_api_key');
    }

    /**
     * Autocomplétion d'adresse
     */
    public function autocomplete(string $input, ?string $language = 'fr'): array
    {
        $cacheKey = 'maps_autocomplete_' . md5($input . $language);
        
        return Cache::remember($cacheKey, 3600, function () use ($input, $language) {
            $response = Http::get("{$this->baseUrl}/place/autocomplete/json", [
                'input' => $input,
                'language' => $language,
                'key' => $this->apiKey,
                'components' => 'country:ci', // Côte d'Ivoire par défaut
            ]);

            return $response->json('predictions', []);
        });
    }

    /**
     * Géocodage : adresse → coordonnées
     */
    public function geocode(string $address): ?array
    {
        $cacheKey = 'maps_geocode_' . md5($address);
        
        return Cache::remember($cacheKey, 86400, function () use ($address) {
            $response = Http::get("{$this->baseUrl}/geocode/json", [
                'address' => $address,
                'key' => $this->apiKey,
            ]);

            $result = $response->json('results.0');
            if (!$result) return null;

            return [
                'latitude' => $result['geometry']['location']['lat'],
                'longitude' => $result['geometry']['location']['lng'],
                'formatted_address' => $result['formatted_address'],
            ];
        });
    }

    /**
     * Géocodage inverse : coordonnées → adresse
     */
    public function reverseGeocode(float $lat, float $lng): ?string
    {
        $response = Http::get("{$this->baseUrl}/geocode/json", [
            'latlng' => "{$lat},{$lng}",
            'key' => $this->apiKey,
        ]);

        return $response->json('results.0.formatted_address');
    }

    /**
     * Calcul de distance et durée entre 2 points
     */
    public function calculateRoute(array $origin, array $destination, string $mode = 'driving'): ?array
    {
        $cacheKey = 'maps_route_' . md5(json_encode([$origin, $destination, $mode]));
        
        return Cache::remember($cacheKey, 1800, function () use ($origin, $destination, $mode) {
            $response = Http::get("{$this->baseUrl}/directions/json", [
                'origin' => "{$origin['lat']},{$origin['lng']}",
                'destination' => "{$destination['lat']},{$destination['lng']}",
                'mode' => $mode,
                'key' => $this->apiKey,
            ]);

            $route = $response->json('routes.0.legs.0');
            if (!$route) return null;

            return [
                'distance_km' => $route['distance']['value'] / 1000,
                'distance_text' => $route['distance']['text'],
                'duration_minutes' => (int) round($route['duration']['value'] / 60),
                'duration_text' => $route['duration']['text'],
            ];
        });
    }

    /**
     * Calcul des frais de livraison basé sur la distance
     */
    public function calculerFraisLivraison(array $origin, array $destination): float
    {
        $route = $this->calculateRoute($origin, $destination, 'driving');
        
        if (!$route) {
            return 1500; // Frais par défaut
        }

        $distance = $route['distance_km'];

        // Grille tarifaire progressive
        if ($distance <= 2) return 1000;
        if ($distance <= 5) return 1500;
        if ($distance <= 10) return 2500;
        if ($distance <= 15) return 3500;
        return 5000;
    }

    /**
     * Recherche de restaurants à proximité (via Google Places)
     */
    public function searchNearby(float $lat, float $lng, int $radius = 5000, string $keyword = 'restaurant'): array
    {
        $response = Http::get('https://maps.googleapis.com/maps/api/place/nearbysearch/json', [
            'location' => "{$lat},{$lng}",
            'radius' => $radius,
            'keyword' => $keyword,
            'key' => config('services.google.places_api_key'),
        ]);

        return $response->json('results', []);
    }
}
