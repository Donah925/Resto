## 1️⃣ MODULE UTILISATEURS & RÔLES (10 tables)

### 1.1 `utilisateurs`
```sql
CREATE TABLE utilisateurs (
    id CHAR(36) NOT NULL DEFAULT (UUID()) PRIMARY KEY,
    prenom VARCHAR(100) NOT NULL,
    nom VARCHAR(100) NOT NULL,
    email VARCHAR(255) NOT NULL UNIQUE,
    email_verifie_le TIMESTAMP NULL,
    telephone VARCHAR(20) NULL,
    telephone_verifie_le TIMESTAMP NULL,
    mot_de_passe VARCHAR(255) NOT NULL,
    role ENUM('superadmin', 'admin', 'gerant', 'livreur', 'client') NOT NULL DEFAULT 'client',
    avatar VARCHAR(255) NULL,
    statut ENUM('actif', 'inactif', 'suspendu', 'banni') NOT NULL DEFAULT 'actif',
    derniere_connexion_le TIMESTAMP NULL,
    langue VARCHAR(10) NOT NULL DEFAULT 'fr',
    fuseau_horaire VARCHAR(50) NOT NULL DEFAULT 'Africa/Abidjan',
    deux_facteur_secret TEXT NULL,
    deux_facteur_codes_recuperation TEXT NULL,
    token_remember VARCHAR(100) NULL,
    photo_profil_chemin VARCHAR(2048) NULL,
    cree_le TIMESTAMP NULL DEFAULT CURRENT_TIMESTAMP,
    modifie_le TIMESTAMP NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
    supprime_le TIMESTAMP NULL,
    
    INDEX idx_email (email),
    INDEX idx_telephone (telephone),
    INDEX idx_role (role),
    INDEX idx_statut (statut)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;
```

