## 2️⃣ MODULE RESTAURANTS (8 tables)

### 2.1 `restaurants`
```sql
CREATE TABLE restaurants (
    id CHAR(36) NOT NULL DEFAULT (UUID()) PRIMARY KEY,
    nom JSON NOT NULL COMMENT 'Multi-langue: {"fr":"Nom","en":"Name"}',
    slug VARCHAR(255) NOT NULL UNIQUE,
    description JSON NULL,
    logo VARCHAR(255) NULL,
    image_couverture VARCHAR(255) NULL,
    telephone VARCHAR(20) NOT NULL,
    email VARCHAR(255) NOT NULL,
    site_web VARCHAR(255) NULL,
    adresse VARCHAR(255) NOT NULL,
    ville VARCHAR(100) NOT NULL,
    code_postal VARCHAR(20) NOT NULL,
    pays VARCHAR(100) NOT NULL DEFAULT 'Côte d\'Ivoire',
    latitude DECIMAL(10, 8) NOT NULL,
    longitude DECIMAL(11, 8) NOT NULL,
    fuseau_horaire VARCHAR(50) NOT NULL DEFAULT 'Africa/Abidjan',
    devise VARCHAR(3) NOT NULL DEFAULT 'XOF',
    taux_tva DECIMAL(5, 2) NOT NULL DEFAULT 18.00,
    livraison_activee BOOLEAN NOT NULL DEFAULT TRUE,
    retrait_active BOOLEAN NOT NULL DEFAULT TRUE,
    sur_place_active BOOLEAN NOT NULL DEFAULT TRUE,
    montant_minimum_commande DECIMAL(10, 2) NOT NULL DEFAULT 0.00,
    rayon_max_livraison INT UNSIGNED NOT NULL DEFAULT 10 COMMENT 'en km',
    temps_preparation INT UNSIGNED NOT NULL DEFAULT 30 COMMENT 'en minutes',
    note DECIMAL(3, 2) NOT NULL DEFAULT 0.00,
    total_avis INT UNSIGNED NOT NULL DEFAULT 0,
    est_en_avant BOOLEAN NOT NULL DEFAULT FALSE,
    statut ENUM('actif', 'inactif', 'en_attente', 'suspendu') NOT NULL DEFAULT 'en_attente',
    cree_le TIMESTAMP NULL DEFAULT CURRENT_TIMESTAMP,
    modifie_le TIMESTAMP NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
    supprime_le TIMESTAMP NULL,
    
    INDEX idx_statut (statut),
    INDEX idx_localisation (latitude, longitude),
    INDEX idx_avant (est_en_avant)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;
```

