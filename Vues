### 11.1 `app/Livewire/Shared/NotificationsDropdown.php`

```php
<?php

namespace App\Livewire\Shared;

use Livewire\Component;
use App\Models\Notification;

class NotificationsDropdown extends Component
{
    public $notifications;
    public $nonLuesCount = 0;

    public function mount()
    {
        $this->chargerNotifications();
    }

    public function chargerNotifications()
    {
        $userId = auth()->id();
        $this->notifications = Notification::utilisateur($userId)
            ->latest('cree_le')
            ->take(10)
            ->get();
        $this->nonLuesCount = Notification::utilisateur($userId)->nonLues()->count();
    }

    public function marquerLue($id)
    {
        Notification::find($id)?->marquerCommeLue();
        $this->chargerNotifications();
    }

    public function toutMarquerLues()
    {
        Notification::marquerToutesCommeLues(auth()->id());
        $this->chargerNotifications();
    }

    public function render()
    {
        return view('livewire.shared.notifications-dropdown');
    }
}
