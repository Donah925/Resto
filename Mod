<?php

namespace App\Models;

use Illuminate\Database\Eloquent\Relations\BelongsTo;
use Illuminate\Database\Eloquent\Relations\HasMany;

class CodePromo extends BaseModel
{
    protected $table = 'codes_promo';

    protected $fillable = [
        'code',
        'restaurant_id',
        'titre',
        'description',
        'type_reduction',
        'valeur_reduction',
        'montant_minimum',
        'montant_maximum_reduction',
        'utilisation_max',
        'utilisation_par_client',
        'date_debut',
        'date_fin',
        'est_actif',
    ];

    protected $casts = [
        'valeur_reduction' => 'decimal:2',
        'montant_minimum' => 'decimal:2',
        'montant_maximum_reduction' => 'decimal:2',
        'utilisation_max' => 'integer',
        'utilisation_par_client' => 'integer',
        'date_debut' => 'datetime',
        'date_fin' => 'datetime',
        'est_actif' => 'boolean',
    ];

    public function restaurant(): BelongsTo
    {
        return $this->belongsTo(Restaurant::class, 'restaurant_id');
    }

    public function utilisations(): HasMany
    {
        return $this->hasMany(UtilisationCodePromo::class, 'code_promo_id');
    }

    public function scopeActifs($query)
    {
        return $query->where('est_actif', true)
            ->where('date_debut', '<=', now())
            ->where(function($q) {
                $q->whereNull('date_fin')
                  ->orWhere('date_fin', '>=', now());
            });
    }

    public function scopeRestaurant($query, $restaurantId)
    {
        return $query->where(function($q) use ($restaurantId) {
            $q->whereNull('restaurant_id')
              ->orWhere('restaurant_id', $restaurantId);
        });
    }

    public function estValidePour(Commande $commande): bool
    {
        // Vérifier dates
        if ($this->date_debut->isFuture()) return false;
        if ($this->date_fin && $this->date_fin->isPast()) return false;

        // Vérifier montant minimum
        if ($this->montant_minimum && $commande->sous_total < $this->montant_minimum) {
            return false;
        }

        // Vérifier utilisation max
        if ($this->utilisation_max && $this->utilisations()->count() >= $this->utilisation_max) {
            return false;
        }

        // Vérifier utilisation par client
        $utilisationsClient = $this->utilisations()
            ->where('client_id', $commande->client_id)
            ->count();

        if ($utilisationsClient >= $this->utilisation_par_client) {
            return false;
        }

        return true;
    }

    public function calculerReduction(float $sousTotal): float
    {
        $reduction = match($this->type_reduction) {
            'pourcentage' => $sousTotal * ($this->valeur_reduction / 100),
            'montant_fixe' => $this->valeur_reduction,
            'livraison_gratuite' => 0, // Traité séparément
            default => 0,
        };

        if ($this->montant_maximum_reduction) {
            $reduction = min($reduction, $this->montant_maximum_reduction);
        }

        return min($reduction, $sousTotal);
    }
}
