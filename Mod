    {
        return $query->where('restaurant_id', $restaurantId);
    }

    // ===== MÉTHODES =====

    public function calculerTotaux(): self
    {
        $sousTotal = $this->lignes->sum(fn($ligne) => $ligne->prix_total_ligne);
        $tauxTva = $this->restaurant->taux_tva / 100;
        $montantTva = $sousTotal * $tauxTva / (1 + $tauxTva);

        $this->update([
            'sous_total' => $sousTotal,
            'montant_tva' => round($montantTva, 2),
            'montant_total' => $sousTotal + $this->frais_livraison - $this->montant_reduction,
        ]);

        return $this;
    }

    public function changerStatut(StatutCommande $nouveauStatut, ?string $commentaire = null, $modifiePar = null): void
    {
        $ancienStatut = $this->statut;
        $this->update(['statut' => $nouveauStatut]);

        $this->historiqueStatuts()->create([
            'statut' => $nouveauStatut->value,
            'commentaire' => $commentaire,
            'modifie_par_id' => $modifiePar?->id,
        ]);

        // Actions spécifiques selon le statut
        if ($nouveauStatut === StatutCommande::LIVREE) {
            $this->update(['heure_livraison_effective' => now()]);
        }

        if ($nouveauStatut === StatutCommande::TERMINEE) {
            $this->client?->ajouterPointsFidelite(
                (int) floor($this->montant_total / 100),
                "Points gagnés sur la commande #{$this->numero}"
            );
        }
    }

    public function estAnnulable(): bool
    {
        return in_array($this->statut, [
            StatutCommande::EN_ATTENTE,
            StatutCommande::CONFIRMEE,
        ]);
    }
