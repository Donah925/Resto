    {
        return $query->whereHas('restaurants', function($q) use ($restaurantId) {
            $q->where('restaurants.id', $restaurantId)
              ->where('produit_restaurant.est_disponible', true);
        });
    }

    // ===== MÉTHODES =====

    public function getPrixActuelAttribute(): float
    {
        return $this->prix_promo ?? $this->prix_base;
    }

    public function estEnPromotion(): bool
    {
        return $this->prix_promo !== null && $this->prix_promo < $this->prix_base;
    }

    public function getPrixPourRestaurant($restaurantId): ?float
    {
        $pivot = $this->restaurants()->where('restaurants.id', $restaurantId)->first()?->pivot;
        return $pivot?->prix;
    }

    public function estEnStock(): bool
    {
        if ($this->quantite_stock === null) {
            return true; // Stock illimité
        }
        return $this->quantite_stock > 0;
    }

    public function decrementerStock(int $quantite = 1): bool
    {
        if (!$this->estEnStock() || $this->quantite_stock < $quantite) {
            return false;
        }

        $this->decrement('quantite_stock', $quantite);
        return true;
    }
