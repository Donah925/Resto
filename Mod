class Portefeuille extends BaseModel
{
    protected $table = 'portefeuilles';

    protected $fillable = ['client_id', 'solde', 'devise'];

    protected $casts = ['solde' => 'decimal:2'];

    public function client(): BelongsTo
    {
        return $this->belongsTo(ProfilClient::class, 'client_id');
    }

    public function transactions(): HasMany
    {
        return $this->hasMany(TransactionPortefeuille::class, 'portefeuille_id');
    }

    public function crediter(float $montant, string $description = null): void
    {
        $ancienSolde = $this->solde;
        $this->increment('solde', $montant);

        $this->transactions()->create([
            'type_transaction' => 'credit',
            'montant' => $montant,
            'solde_avant' => $ancienSolde,
            'solde_apres' => $this->solde,
            'description' => $description,
        ]);
    }

    public function debiter(float $montant, string $description = null): bool
    {
        if ($this->solde < $montant) {
            return false;
        }

        $ancienSolde = $this->solde;
        $this->decrement('solde', $montant);

        $this->transactions()->create([
            'type_transaction' => 'debit',
            'montant' => -$montant,
            'solde_avant' => $ancienSolde,
            'solde_apres' => $this->solde,
            'description' => $description,
        ]);

        return true;
    }
}
