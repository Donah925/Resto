    {
        return $this->hasMany(Livraison::class, 'zone_id');
    }

    public function scopeActives($query)
    {
        return $query->where('est_active', true);
    }

    /**
     * Vérifie si des coordonnées sont dans la zone
     */
    public function contientPoint(float $latitude, float $longitude): bool
    {
        $polygone = $this->polygone_geojson;

        if (!$polygone || !isset($polygone['coordinates'])) {
            return false;
        }

        // Algorithme point-in-polygon (Ray casting)
        $points = $polygone['coordinates'][0];
        $intersections = 0;
        $count = count($points);

        for ($i = 0; $i < $count; $i++) {
            $j = ($i + 1) % $count;
            $xi = $points[$i][1]; $yi = $points[$i][0];
            $xj = $points[$j][1]; $yj = $points[$j][0];

            $intersect = (($yi > $longitude) != ($yj > $longitude))
                && ($latitude < ($xj - $xi) * ($longitude - $yi) / ($yj - $yi + 0.0000001) + $xi);

            if ($intersect) $intersections++;
        }

        return ($intersections % 2) === 1;
    }
}
