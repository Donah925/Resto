APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

# === BROADCASTING (Temps réel - Reverb) ===
REVERB_APP_ID=resto-app-id
REVERB_APP_KEY=resto-app-key
REVERB_APP_SECRET=resto-app-secret
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# === APIs Tiers (Paiement, SMS, Email, Maps, etc.) ===

# Stripe (Paiement CB)
STRIPE_PUBLIC_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# PayPal (Paiement alternatif)
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret
PAYPAL_ENVIRONMENT=sandbox # sandbox ou production
PAYPAL_WEBHOOK_ID=your_webhook_id

# Twilio (SMS)
TWILIO_ENABLED=false
TWILIO_SID=AC...
TWILIO_TOKEN=your_twilio_token
TWILIO_FROM_NUMBER=+1234567890

# SendGrid (Emails transactionnels)
SENDGRID_ENABLED=false
SENDGRID_API_KEY=SG....
SENDGRID_FROM_EMAIL=noreply@votreapp.com
SENDGRID_FROM_NAME="Resto App"

# Mapbox (Cartes et géolocalisation)
MAPBOX_ENABLED=false
MAPBOX_API_KEY=pk.your_mapbox_key

# Google (Maps, OAuth, Analytics)
GOOGLE_MAPS_API_KEY=AIza...
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=https://votreapp.com/auth/google/callback
GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX

# Facebook / Meta (OAuth, Pixel)
FACEBOOK_CLIENT_ID=your_facebook_app_id
FACEBOOK_CLIENT_SECRET=your_facebook_app_secret
FACEBOOK_REDIRECT_URI=https://votreapp.com/auth/facebook/callback
FACEBOOK_PIXEL_ID=your_pixel_id

# Apple (Sign in with Apple)
APPLE_CLIENT_ID=your_apple_service_id
APPLE_CLIENT_SECRET=your_apple_client_secret
APPLE_REDIRECT_URI=https://votreapp.com/auth/apple/callback
APPLE_TEAM_ID=your_team_id
APPLE_KEY_ID=your_key_id
APPLE_PRIVATE_KEY_PATH=storage/app/apple/AuthKey.p8

# Firebase (Analytics, Push Notifications)
FIREBASE_ENABLED=false
FIREBASE_CREDENTIALS_PATH=storage/app/firebase/credentials.json
FIREBASE_DATABASE_URL=https://your-project.firebaseio.com
FIREBASE_PROJECT_ID=your-firebase-project-id
